# Copy this file to server/.env and fill it in. Never commit the real .env file.

# --- Live payments with Razorpay (https://dashboard.razorpay.com) ---
# Settings -> API Keys. Use the "rzp_test_..." keys first, "rzp_live_..." when ready.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Razorpay can also push "payment received" to
# https://<your-server>/api/webhook/razorpay  (Settings -> Webhooks, event: qr_code.credited).
# Put the webhook secret you chose there. The site works without it.
RAZORPAY_WEBHOOK_SECRET=

# --- Demo mode: simulated payments, no keys needed ---
# Set MOCK=1 to try the whole flow. The QR it shows uses UPI_ID/UPI_NAME below
# and a "Simulate payment" button completes the check-out.
MOCK=
UPI_ID=7754084726-4@ibl
UPI_NAME=RAJ MAURYA

# Port to listen on (hosting services set this for you).
PORT=3000

# Only needed if the website is hosted on a different address than this server.
ALLOWED_ORIGIN=
